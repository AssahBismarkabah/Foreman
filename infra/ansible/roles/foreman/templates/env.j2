# Foreman environment variables (managed by Ansible)
{% if foreman_signing_key | length > 0 %}FOREMAN_SIGNING_KEY={{ foreman_signing_key }}{% endif %}
{% if openai_api_key | length > 0 %}OPENAI_API_KEY={{ openai_api_key }}{% endif %}
{% if openai_base_url | length > 0 %}OPENAI_BASE_URL={{ openai_base_url }}{% endif %}
{% if openai_model | length > 0 %}OPENAI_MODEL={{ openai_model }}{% endif %}
